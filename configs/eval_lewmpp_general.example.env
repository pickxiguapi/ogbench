source "$REPO_ROOT/configs/lewmpp_paths.env"
export PYTHON_BIN=python
export CUDA_VISIBLE_DEVICES=0
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl
export EGL_PLATFORM=surfaceless

# Change both GOAL_OFFSET_STEPS and EVAL_BUDGET for H50/H75/H100.
TASK=cube
GOAL_OFFSET_STEPS=50
EVAL_BUDGET=100
EVAL_SEED=0
EXPERIMENT_GROUP="lewmpp_h${GOAL_OFFSET_STEPS}_seed${EVAL_SEED}"
RESULT_DIR="$OUTPUT_ROOT/$EXPERIMENT_GROUP/general_uniform_future/latent_path_flow/H${GOAL_OFFSET_STEPS}/full/policy_mode/seed${EVAL_SEED}/$TASK"
LOG_FILE="$RESULT_DIR/eval.log"
EVAL_ARGS=(
  --task="$TASK"
  --variant=full
  --experiment-group="$EXPERIMENT_GROUP"
  --generator-family=general_uniform_future
  --generator-type=latent_path_flow
  --data-root="$LEWM_DATA_ROOT"
  --lewm-checkpoint="$LEWM_CUBE_CHECKPOINT"
  --action-prior-checkpoint-dir="$POLICY_CUBE_CHECKPOINT_DIR"
  --action-prior-checkpoint-step=100000
  --action-prior-mode=policy_mode
  --subgoal-generator-checkpoint="$GENERAL_CUBE_CHECKPOINT"
  --flow-sampling-steps=16
  --generator-num-samples=1
  --num-eval=50
  --seed="$EVAL_SEED"
  --goal-offset-steps="$GOAL_OFFSET_STEPS"
  --eval-budget="$EVAL_BUDGET"
  --cem-horizon=2
  --cem-receding-horizon=1
  --action-block=5
  --cem-num-samples=300
  --cem-iterations=5
  --cem-topk=30
  --cem-var-scale=1.0
  --cem-min-std=0.001
  --cem-cost-mode=moh
  --output="$RESULT_DIR/result.json"
)
