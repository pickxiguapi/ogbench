source "$REPO_ROOT/configs/lewmpp_paths.env"
export PYTHON_BIN=python
export CUDA_VISIBLE_DEVICES=0
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl
export EGL_PLATFORM=surfaceless

TASK=cube
EVAL_SEED=0
EXPERIMENT_GROUP=lewmpp_h25_seed0
RESULT_DIR="$OUTPUT_ROOT/$EXPERIMENT_GROUP/goalmax25/latent_path_flow/H25/full/policy_mode/seed${EVAL_SEED}/$TASK"
LOG_FILE="$RESULT_DIR/eval.log"
EVAL_ARGS=(
  --task="$TASK"
  --variant=full
  --experiment-group="$EXPERIMENT_GROUP"
  --generator-family=goalmax25
  --generator-type=latent_path_flow
  --data-root="$LEWM_DATA_ROOT"
  --lewm-checkpoint="$LEWM_CUBE_CHECKPOINT"
  --action-prior-checkpoint-dir="$POLICY_CUBE_CHECKPOINT_DIR"
  --action-prior-checkpoint-step=100000
  --action-prior-mode=policy_mode
  --subgoal-generator-checkpoint="$GOALMAX25_CUBE_CHECKPOINT"
  --flow-sampling-steps=16
  --generator-num-samples=1
  --num-eval=50
  --seed="$EVAL_SEED"
  --goal-offset-steps=25
  --eval-budget=50
  --cem-horizon=2
  --cem-receding-horizon=1
  --action-block=5
  --cem-num-samples=300
  --cem-iterations=5
  --cem-topk=30
  --cem-var-scale=1.0
  --cem-min-std=0.001
  --cem-cost-mode=moh
  --output="$RESULT_DIR/result.json"
)
