export PYTHON_BIN=python
export CUDA_VISIBLE_DEVICES=0
export XLA_PYTHON_CLIENT_PREALLOCATE=false

# Choices: mlp, endpoint_flow, latent_path_flow.
GENERATOR_TYPE=latent_path_flow
# Choices: goalmax25, general_uniform_future.
GENERATOR_FAMILY=goalmax25
# Use 1 for MLP and 8 for either flow model.
GENERATOR_NUM_SAMPLES=8

TRAIN_ENTRYPOINT=train_subgoal_generator.py
LOG_FILE=/path/to/runs/subgoal-generators/goalmax25/latent_path_flow/cube/train.log
TRAIN_ARGS=(
  --latent-dataset=/path/to/data/lewm-latents/cube.h5
  --save-dir=/path/to/runs/subgoal-generators/goalmax25/latent_path_flow/cube
  --exp-name=lewmpp_goalmax25_latent_path_flow_cube_seed0
  --generator-family="$GENERATOR_FAMILY"
  --generator-type="$GENERATOR_TYPE"
  --seed=0
  --split-seed=0
  --train-fraction=0.95
  --subgoal-steps=10
  --action-block=5
  --history-size=3
  --train-steps=200000
  --batch-size=1024
  --hidden-dim=512
  --hidden-dims=512 512 512
  --depth=4
  --num-heads=8
  --ff-dim=2048
  --time-dim=64
  --flow-sampling-steps=16
  --num-samples="$GENERATOR_NUM_SAMPLES"
  --ema-decay=0.9999
  --learning-rate=1e-4
  --final-learning-rate=1e-5
  --warmup-steps=5000
  --weight-decay=1e-4
  --gradient-clip=1.0
  --validation-pairs=10000
  --eval-batch-size=1024
  --log-interval=1000
  --eval-interval=10000
  --checkpoint-interval=25000
  --resume
)
