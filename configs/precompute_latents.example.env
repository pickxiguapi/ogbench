export PYTHON_BIN=python
export CUDA_VISIBLE_DEVICES=0
export XLA_PYTHON_CLIENT_PREALLOCATE=false

TRAIN_ENTRYPOINT=precompute_lewm_latents.py
LOG_FILE=/path/to/data/lewm-latents/cube.log
TRAIN_ARGS=(
  --task=cube
  --lance-path=/path/to/data/cube_single_expert.lance
  --checkpoint=/path/to/runs/lewm/cube/weights_epoch_10.msgpack
  --output=/path/to/data/lewm-latents/cube.h5
  --batch-size=512
  --decode-workers=12
  --output-dtype=float32
)
