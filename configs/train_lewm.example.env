export PYTHON_BIN=python
export CUDA_VISIBLE_DEVICES=0
export XLA_PYTHON_CLIENT_PREALLOCATE=false

TRAIN_ENTRYPOINT=train_lewm_jax.py
LOG_FILE=/path/to/runs/lewm/cube/train.log
TRAIN_ARGS=(
  --dataset_path=/path/to/data/cube_single_expert.lance
  --save_dir=/path/to/runs/lewm/cube
  --exp_name=lewm_cube_seed3072
  --decode_workers=6
  --seed=3072
  --epochs=10
  --save_interval_steps=100000
  --batch_size=128
  --frameskip=5
  --image_size=224
  --learning_rate=5e-5
  --weight_decay=1e-3
  --sigreg_weight=0.09
  --sigreg_knots=17
  --sigreg_num_proj=1024
)
