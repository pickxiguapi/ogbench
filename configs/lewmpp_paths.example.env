# Dataset root consumed by ogbench.lewm_envs.evaluation.task_paths.
export LEWM_DATA_ROOT=/path/to/lewm-4tasks-data
export OUTPUT_ROOT=/path/to/lewmpp-results

# Frozen LeWM checkpoints. Paper protocol: PushT uses seed 666; the other tasks use seed 3072.
export LEWM_CUBE_CHECKPOINT=/path/to/cube/weights_epoch_10.msgpack
export LEWM_PUSHT_CHECKPOINT=/path/to/pusht/weights_epoch_10.msgpack
export LEWM_REACHER_CHECKPOINT=/path/to/reacher/weights_epoch_10.msgpack
export LEWM_TWOROOM_CHECKPOINT=/path/to/tworoom/weights_epoch_10.msgpack

# Final-goal-conditioned Action-Prior-Chunk checkpoints (training seed 777).
export ACTION_PRIOR_CUBE_CHECKPOINT_DIR=/path/to/cube/action-prior
export ACTION_PRIOR_PUSHT_CHECKPOINT_DIR=/path/to/pusht/action-prior
export ACTION_PRIOR_REACHER_CHECKPOINT_DIR=/path/to/reacher/action-prior
export ACTION_PRIOR_TWOROOM_CHECKPOINT_DIR=/path/to/tworoom/action-prior

# H25 bounded-offset LatentPathFlow checkpoints used by the H25 eval configs.
# For an MLP or Endpoint Flow run, pass its path as SUBGOAL_GENERATOR_CHECKPOINT to evaluate.sh.
export GOALMAX25_CUBE_CHECKPOINT=/path/to/goalmax25/cube/checkpoint_200000.msgpack
export GOALMAX25_PUSHT_CHECKPOINT=/path/to/goalmax25/pusht/checkpoint_200000.msgpack
export GOALMAX25_REACHER_CHECKPOINT=/path/to/goalmax25/reacher/checkpoint_200000.msgpack
export GOALMAX25_TWOROOM_CHECKPOINT=/path/to/goalmax25/tworoom/checkpoint_200000.msgpack

# H50/H75/H100 full-future LatentPathFlow checkpoints used by the general eval configs.
export GENERAL_CUBE_CHECKPOINT=/path/to/general_uniform_future/cube/checkpoint_200000.msgpack
export GENERAL_PUSHT_CHECKPOINT=/path/to/general_uniform_future/pusht/checkpoint_200000.msgpack
export GENERAL_REACHER_CHECKPOINT=/path/to/general_uniform_future/reacher/checkpoint_200000.msgpack
export GENERAL_TWOROOM_CHECKPOINT=/path/to/general_uniform_future/tworoom/checkpoint_200000.msgpack
