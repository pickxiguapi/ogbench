export PYTHON_BIN=python
export CUDA_VISIBLE_DEVICES=0
export XLA_PYTHON_CLIENT_PREALLOCATE=false

TRAIN_ENTRYPOINT=action-prior-chunk.py
LOG_FILE=/path/to/runs/action-prior/cube/train.log
TRAIN_ARGS=(
  --dataset_path=/path/to/data/cube_single_expert.lance
  --lewm_checkpoint=/path/to/runs/lewm/cube/weights_epoch_10.msgpack
  --save_dir=/path/to/runs/action-prior/cube
  --train_steps=100000
  --save_interval=100000
  --log_interval=5000
  --batch_size=256
  --seed=777
  --lr=3e-4
  --discount=0.99
  --expectile=0.9
  --tau=0.005
  --chunk_size=5
  --alpha=3.0
  --p_aug=0.0
  --validation_fraction=0.05
)
